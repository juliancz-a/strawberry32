import { Theme } from "../theme.slint";
import { CatalogRow, CatalogItem } from "../components/catalog_row.slint";
import { ScrollView } from "std-widgets.slint";

export component LibraryView inherits Rectangle {
    in property <[CatalogItem]> library_items: [];
    callback card_selected(string, string);
    callback explore_clicked();
    callback clear_history_clicked();

    background: Theme.bg;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "📚 My Library & Watch History";
                font-size: 20px;
                font-weight: 800;
                color: Theme.text;
                vertical-alignment: center;
            }

            if root.library_items.length > 0 : Rectangle {
                width: 120px;
                height: 32px;
                background: clr_touch.pressed ? Theme.surface-raised : (clr_touch.has-hover ? #3a2025 : Theme.surface);
                border-radius: 6px;
                border-width: 1px;
                border-color: clr_touch.has-hover ? #ff453a : Theme.surface-raised;

                clr_touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.clear_history_clicked();
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "🗑 Clear History";
                        font-size: 12px;
                        font-weight: 600;
                        color: #ff6b6b;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.library_items.length == 0 : Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            height: 200px;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text {
                    text: "Your library is empty";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Movies and series you watch will automatically be saved here so you can easily continue watching.";
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 140px;
                        height: 36px;
                        background: exp_touch.pressed ? Theme.accent-pressed : (exp_touch.has-hover ? #ff709e : Theme.accent);
                        border-radius: 6px;

                        exp_touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.explore_clicked(); }
                        }

                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "Explore Movies";
                                font-size: 13px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        if root.library_items.length > 0 : ScrollView {
            VerticalLayout {
                CatalogRow {
                    title: "Continue Watching (" + root.library_items.length + ")";
                    items: root.library_items;
                    card_clicked(id, type) => {
                        root.card_selected(id, type);
                    }
                }
            }
        }
    }
}

