import { Theme } from "../theme.slint";
import { ScrollView, LineEdit, Button } from "std-widgets.slint";

export struct AddonItem {
    id: string,
    name: string,
    version: string,
    description: string,
    enabled: bool,
}

component SettingsTabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> is_active: false;
    callback clicked();

    height: 44px;
    background: root.is_active ? Theme.surface-raised : (touch.has-hover ? Theme.surface-hover : #00000000);
    border-radius: 6px;

    if root.is_active : Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: 28px;
        background: Theme.accent;
        border-radius: 2px;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: start;

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.is_active ? 700 : 500;
            color: root.is_active ? #ffffff : (touch.has-hover ? #ffffff : Theme.text-muted);
            vertical-alignment: center;
        }
    }
}

component ChipButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> is_active: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: root.is_active ? Theme.accent : (touch.has-hover ? #2a2b2e : #1c1d20);
    border-width: 1px;
    border-color: root.is_active ? Theme.accent : (touch.has-hover ? #505258 : #333438);

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.is_active ? 700 : 500;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
}

export component SettingsView inherits Rectangle {
    in-out property <int> active_tab: 0; // 0=Add-ons, 1=Playback, 2=Streaming, 3=Interface, 4=Diagnostics, 5=About
    in-out property <[AddonItem]> addon_items: [];
    in-out property <string> install_url_input: "";

    // Playback Settings
    in-out property <int> max_resolution: 720;
    in-out property <bool> prefer_mp4: true;
    in-out property <string> sub_lang: "en";
    in-out property <string> audio_lang: "en";
    in-out property <bool> autoplay_next: true;
    in-out property <int> seek_step: 15;

    // Streaming & Cache Settings
    in-out property <string> torrent_cache_str: "0 MB / 2048 MB";
    in-out property <string> image_cache_str: "0 MB / 48 MB";
    in-out property <int> max_cache_gb: 2;
    in-out property <bool> keep_after_playback: false;

    // Interface Settings
    in-out property <bool> reduce_animations: false;
    in-out property <bool> hero_autorotate: true;
    in-out property <string> card_size: "m";

    // Diagnostics
    in-out property <string> platform_str: "Windows RT 8.1 ARM32 • Tegra 3 (DXVA2 Active)";
    in-out property <string> storage_path_str: "";
    in-out property <[string]> log_lines: [];

    callback tab_changed(int);
    callback install_addon_clicked(string);
    callback quick_setup_clicked();
    callback toggle_addon_clicked(string);
    callback remove_addon_clicked(string);
    callback priority_addon_clicked(string, bool);
    callback max_res_changed(int);
    callback prefer_mp4_toggled(bool);
    callback sub_lang_changed(string);
    callback audio_lang_changed(string);
    callback autoplay_next_toggled(bool);
    callback seek_step_changed(int);
    callback max_cache_changed(int);
    callback keep_playback_toggled(bool);
    callback clear_torrent_cache_clicked();
    callback clear_image_cache_clicked();
    callback reduce_anim_toggled(bool);
    callback hero_rotate_toggled(bool);
    callback card_size_changed(string);
    callback clear_logs_clicked();

    background: Theme.bg;

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        // Left Navigation Column (Categories)
        Rectangle {
            width: 200px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.surface-raised;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;

                Text {
                    text: "Settings";
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.text;
                }

                Rectangle { height: 8px; }

                SettingsTabButton {
                    label: "🧩 Add-ons";
                    is_active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; root.tab_changed(0); }
                }

                SettingsTabButton {
                    label: "▶ Playback";
                    is_active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; root.tab_changed(1); }
                }

                SettingsTabButton {
                    label: "💾 Streaming & Cache";
                    is_active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; root.tab_changed(2); }
                }

                SettingsTabButton {
                    label: "🎨 Interface";
                    is_active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; root.tab_changed(3); }
                }

                SettingsTabButton {
                    label: "⚡ Diagnostics & Logs";
                    is_active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; root.tab_changed(4); }
                }

                SettingsTabButton {
                    label: "ℹ️ About Strawberry32";
                    is_active: root.active_tab == 5;
                    clicked => { root.active_tab = 5; root.tab_changed(5); }
                }

                Rectangle {}
            }
        }

        // Right Content Panel
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.surface-raised;
            clip: true;

            ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    // TAB 0: ADD-ONS MANAGER
                    if root.active_tab == 0 : VerticalLayout {
                        spacing: 14px;

                        Text {
                            text: "Add-ons Manager";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        // Install Add-on Row
                        Rectangle {
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                alignment: space-between;

                                LineEdit {
                                    placeholder-text: "Paste manifest URL (e.g. https://... or stremio://...)";
                                    text <=> root.install_url_input;
                                    horizontal-stretch: 1;
                                }

                                Button {
                                    text: "Install Add-on";
                                    clicked => {
                                        if (root.install_url_input != "") {
                                            root.install_addon_clicked(root.install_url_input);
                                            root.install_url_input = "";
                                        }
                                    }
                                }

                                Button {
                                    text: "⚡ Quick Setup";
                                    clicked => { root.quick_setup_clicked(); }
                                }
                            }
                        }

                        Text {
                            text: "Installed Add-ons (" + root.addon_items.length + "):";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.accent;
                        }

                        for addon in root.addon_items : Rectangle {
                            height: 64px;
                            background: #1c1d20;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2e3034;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: addon.name;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: "v" + addon.version;
                                            font-size: 11px;
                                            color: Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: addon.description != "" ? addon.description : "Community add-on";
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                        overflow: elide;
                                        max-width: 480px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    ChipButton {
                                        text: addon.enabled ? "Enabled ✓" : "Disabled";
                                        is_active: addon.enabled;
                                        clicked => { root.toggle_addon_clicked(addon.id); }
                                    }

                                    ChipButton {
                                        text: "▲";
                                        clicked => { root.priority_addon_clicked(addon.id, true); }
                                    }

                                    ChipButton {
                                        text: "▼";
                                        clicked => { root.priority_addon_clicked(addon.id, false); }
                                    }

                                    Button {
                                        text: "Remove";
                                        clicked => { root.remove_addon_clicked(addon.id); }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 1: PLAYBACK
                    if root.active_tab == 1 : VerticalLayout {
                        spacing: 16px;

                        Text {
                            text: "Playback Settings";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        Text {
                            text: "Maximum Target Video Resolution:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton {
                                text: "480p SD";
                                is_active: root.max_resolution == 480;
                                clicked => { root.max_res_changed(480); }
                            }
                            ChipButton {
                                text: "720p HD (Recommended for Tegra 3)";
                                is_active: root.max_resolution == 720;
                                clicked => { root.max_res_changed(720); }
                            }
                            ChipButton {
                                text: "1080p FHD (Experimental)";
                                is_active: root.max_resolution == 1080;
                                clicked => { root.max_res_changed(1080); }
                            }
                        }

                        Text {
                            text: "Preferred Media Container:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton {
                                text: "MP4 Native (Zero Remux Overhead)";
                                is_active: root.prefer_mp4;
                                clicked => { root.prefer_mp4_toggled(true); }
                            }
                            ChipButton {
                                text: "Allow MKV (Uses Remux Proxy)";
                                is_active: !root.prefer_mp4;
                                clicked => { root.prefer_mp4_toggled(false); }
                            }
                        }

                        Text {
                            text: "Default Subtitle Language:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton { text: "English (en)"; is_active: root.sub_lang == "en"; clicked => { root.sub_lang_changed("en"); } }
                            ChipButton { text: "Spanish (es)"; is_active: root.sub_lang == "es"; clicked => { root.sub_lang_changed("es"); } }
                            ChipButton { text: "French (fr)"; is_active: root.sub_lang == "fr"; clicked => { root.sub_lang_changed("fr"); } }
                            ChipButton { text: "German (de)"; is_active: root.sub_lang == "de"; clicked => { root.sub_lang_changed("de"); } }
                        }

                        Text {
                            text: "Seek Button Step:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton { text: "10 seconds"; is_active: root.seek_step == 10; clicked => { root.seek_step_changed(10); } }
                            ChipButton { text: "15 seconds"; is_active: root.seek_step == 15; clicked => { root.seek_step_changed(15); } }
                            ChipButton { text: "30 seconds"; is_active: root.seek_step == 30; clicked => { root.seek_step_changed(30); } }
                        }

                        Text {
                            text: "Series Playback:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton {
                                text: root.autoplay_next ? "Auto-play Next Episode: ON" : "Auto-play Next Episode: OFF";
                                is_active: root.autoplay_next;
                                clicked => { root.autoplay_next_toggled(!root.autoplay_next); }
                            }
                        }
                    }

                    // TAB 2: STREAMING & CACHE
                    if root.active_tab == 2 : VerticalLayout {
                        spacing: 16px;

                        Text {
                            text: "Streaming & Cache Management";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        Text {
                            text: "Maximum Torrent Disk Cache Size:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton { text: "1 GB"; is_active: root.max_cache_gb == 1; clicked => { root.max_cache_changed(1); } }
                            ChipButton { text: "2 GB (Default)"; is_active: root.max_cache_gb == 2; clicked => { root.max_cache_changed(2); } }
                            ChipButton { text: "5 GB"; is_active: root.max_cache_gb == 5; clicked => { root.max_cache_changed(5); } }
                            ChipButton { text: "10 GB"; is_active: root.max_cache_gb == 10; clicked => { root.max_cache_changed(10); } }
                        }

                        // Usage info
                        Rectangle {
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                Text {
                                    text: "Current Torrent Cache Usage: " + root.torrent_cache_str;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text;
                                }

                                Text {
                                    text: "Current Image Poster Cache Usage: " + root.image_cache_str;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    Button {
                                        text: "Clear Torrent Chunks";
                                        clicked => { root.clear_torrent_cache_clicked(); }
                                    }

                                    Button {
                                        text: "Clear Image Cache";
                                        clicked => { root.clear_image_cache_clicked(); }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Torrent Retention Policy:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton {
                                text: root.keep_after_playback ? "Keep Data After Playback: ON" : "Auto-Delete Torrent After Playback: ON";
                                is_active: !root.keep_after_playback;
                                clicked => { root.keep_playback_toggled(!root.keep_after_playback); }
                            }
                        }
                    }

                    // TAB 3: INTERFACE
                    if root.active_tab == 3 : VerticalLayout {
                        spacing: 16px;

                        Text {
                            text: "Interface & Animation Settings";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        Text {
                            text: "Tegra 3 Performance Optimizations:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton {
                                text: root.reduce_animations ? "Reduce Animations: ON (Saves CPU)" : "Reduce Animations: OFF";
                                is_active: root.reduce_animations;
                                clicked => { root.reduce_anim_toggled(!root.reduce_animations); }
                            }

                            ChipButton {
                                text: root.hero_autorotate ? "Hero Auto-Rotate: ON" : "Hero Auto-Rotate: OFF";
                                is_active: root.hero_autorotate;
                                clicked => { root.hero_rotate_toggled(!root.hero_autorotate); }
                            }
                        }

                        Text {
                            text: "Catalog Poster Card Size:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ChipButton { text: "Small (120px)"; is_active: root.card_size == "s"; clicked => { root.card_size_changed("s"); } }
                            ChipButton { text: "Medium (146px - Default)"; is_active: root.card_size == "m"; clicked => { root.card_size_changed("m"); } }
                            ChipButton { text: "Large (180px)"; is_active: root.card_size == "l"; clicked => { root.card_size_changed("l"); } }
                        }
                    }

                    // TAB 4: DIAGNOSTICS & LOGS
                    if root.active_tab == 4 : VerticalLayout {
                        spacing: 14px;

                        Text {
                            text: "System Telemetry & Live Diagnostics";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        Rectangle {
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text {
                                    text: "Hardware Platform: " + root.platform_str;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Storage Root: " + root.storage_path_str;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Live Diagnostic Logs (" + root.log_lines.length + " entries):";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Clear Logs";
                                clicked => { root.clear_logs_clicked(); }
                            }
                        }

                        Rectangle {
                            height: 280px;
                            background: #0d0e0f;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2e3034;

                            ScrollView {
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 2px;
                                    for line in root.log_lines : Text {
                                        text: line;
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }

                    // TAB 5: ABOUT
                    if root.active_tab == 5 : VerticalLayout {
                        spacing: 14px;

                        Text {
                            text: "About Strawberry32";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        Rectangle {
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text {
                                    text: "Strawberry32 — Windows RT 8.1 ARM32 Edition";
                                    font-size: 14px;
                                    font-weight: 800;
                                    color: Theme.accent;
                                }
                                Text {
                                    text: "Version: 0.1.0 • Built with Rust and Slint Software Renderer";
                                    font-size: 12px;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Target Architecture: ARMv7-A (thumbv7a-pc-windows-msvc) for NVIDIA Tegra 3 (Surface RT)";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                }
                                Text {
                                    text: "Hardware Decoders: DirectShow / Media Foundation DXVA2 Hardware H.264 Acceleration";
                                    font-size: 12px;
                                    color: Theme.ok;
                                }
                            }
                        }

                        Text {
                            text: "Open Source Libraries & Protocols:";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: "• Slint UI Framework (slint.dev)\n• librqbit Pure-Rust BitTorrent Engine\n• Stremio Addon Protocol v3\n• Cinemeta & OpenSubtitles\n• Windows Media Foundation (MFPlay)";
                            font-size: 12px;
                            color: Theme.text-muted;
                        }
                    }

                    Rectangle {}
                }
            }
        }
    }
}

