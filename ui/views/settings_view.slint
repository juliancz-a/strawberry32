import { Theme } from "../theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

export struct AddonItem {
    id: string,
    name: string,
    version: string,
    description: string,
    enabled: bool,
}

component SettingsButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> is_accent: false;
    callback clicked();

    height: 34px;
    min-width: 80px;
    border-radius: 6px;
    background: root.is_accent ? (btn_touch.pressed ? Theme.accent-pressed : (btn_touch.has-hover ? #ff709e : Theme.accent))
                               : (btn_touch.pressed ? #1e1e24 : (btn_touch.has-hover ? #2e2e36 : #26262b));
    border-width: 1px;
    border-color: root.is_accent ? Theme.accent : (btn_touch.has-hover ? #50525c : #383842);

    btn_touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: #f1f1f4;
            vertical-alignment: center;
        }
    }
}

// Slint Software-Renderer friendly iOS/macOS styled Toggle switch
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : #3a3c42;
    background: root.checked ? Theme.accent : #222328;
    animate background, border-color { duration: 140ms; }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        animate x { duration: 140ms; easing: ease-in-out; }
    }
}

// Compact settings row: label (+ optional description) on the left, Toggle on the right
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in-out property <bool> checked;
    callback toggled(bool);

    height: root.description != "" ? 56px : 42px;
    background: Theme.surface-raised;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.description != "" : Text {
                text: root.description;
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                checked <=> root.checked;
                toggled(val) => { root.toggled(val); }
            }
        }
    }
}

// Compact settings row: label (+ optional description) on the left, control on the right
component FieldRow inherits Rectangle {
    in property <string> label;
    in property <string> description;

    height: root.description != "" ? 66px : 46px;
    background: Theme.surface-raised;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.description != "" : Text {
                text: root.description;
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component SettingsTabButton inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> is_active: false;
    callback clicked();

    height: 44px;
    background: root.is_active ? Theme.surface-raised : (touch.has-hover ? Theme.surface-hover : #00000000);
    border-radius: 6px;

    if root.is_active : Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: 28px;
        background: Theme.accent;
        border-radius: 2px;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            width: 20px;
            if root.icon.width > 0 : Image {
                source: root.icon;
                width: 18px;
                height: 18px;
                colorize: root.is_active ? Theme.accent : Theme.text-muted;
            }
        }

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.is_active ? 700 : 500;
            color: root.is_active ? #ffffff : (touch.has-hover ? #ffffff : Theme.text-muted);
            vertical-alignment: center;
        }
    }
}

component ChipButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> is_active: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: root.is_active ? Theme.accent : (touch.has-hover ? #2a2b2e : #1c1d20);
    border-width: 1px;
    border-color: root.is_active ? Theme.accent : (touch.has-hover ? #505258 : #333438);

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.is_active ? 700 : 500;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
}

export component SettingsView inherits Rectangle {
    in-out property <int> active_tab: 0; // 0=Add-ons, 1=Playback, 2=Streaming, 3=Interface, 4=Diagnostics, 5=About
    in-out property <[AddonItem]> addon_items: [];
    in-out property <string> install_url_input: "";

    // Playback Settings
    in-out property <int> max_resolution: 720;
    in-out property <bool> prefer_mp4: true;
    in-out property <string> sub_lang: "en";
    in-out property <string> audio_lang: "en";
    in-out property <bool> autoplay_next: true;
    in-out property <int> seek_step: 15;

    // Streaming & Cache Settings
    in-out property <string> torrent_cache_str: "0 MB / 2048 MB";
    in-out property <string> image_cache_str: "0 MB / 48 MB";
    in-out property <int> max_cache_gb: 2;
    in-out property <bool> keep_after_playback: false;

    // Interface Settings
    in-out property <bool> reduce_animations: false;
    in-out property <bool> hero_autorotate: true;
    in-out property <string> card_size: "m";

    // Diagnostics
    in-out property <string> platform_str: "Windows RT 8.1 ARM32 • Tegra 3 (DXVA2 Active)";
    in-out property <string> storage_path_str: "";
    in-out property <[string]> log_lines: [];

    callback tab_changed(int);
    callback install_addon_clicked(string);
    callback quick_setup_clicked();
    callback toggle_addon_clicked(string);
    callback remove_addon_clicked(string);
    callback priority_addon_clicked(string, bool);
    callback max_res_changed(int);
    callback prefer_mp4_toggled(bool);
    callback sub_lang_changed(string);
    callback audio_lang_changed(string);
    callback autoplay_next_toggled(bool);
    callback seek_step_changed(int);
    callback max_cache_changed(int);
    callback keep_playback_toggled(bool);
    callback clear_torrent_cache_clicked();
    callback clear_image_cache_clicked();
    callback reduce_anim_toggled(bool);
    callback hero_rotate_toggled(bool);
    callback card_size_changed(string);
    callback clear_logs_clicked();

    background: Theme.bg;

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        // Left Navigation Column (Categories)
        Rectangle {
            width: 210px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.surface-raised;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;

                Text {
                    text: "Settings";
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.text;
                }

                Rectangle { height: 8px; }

                SettingsTabButton {
                    label: "Add-ons Manager";
                    icon: @image-url("../icons/shield.svg");
                    is_active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; root.tab_changed(0); }
                }

                SettingsTabButton {
                    label: "Playback";
                    icon: @image-url("../icons/sliders-horizontal.svg");
                    is_active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; root.tab_changed(1); }
                }

                SettingsTabButton {
                    label: "Streaming & Cache";
                    icon: @image-url("../icons/server.svg");
                    is_active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; root.tab_changed(2); }
                }

                SettingsTabButton {
                    label: "Interface";
                    icon: @image-url("../icons/globe.svg");
                    is_active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; root.tab_changed(3); }
                }

                SettingsTabButton {
                    label: "Diagnostics & Logs";
                    icon: @image-url("../icons/scroll-text.svg");
                    is_active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; root.tab_changed(4); }
                }

                SettingsTabButton {
                    label: "About Strawberry32";
                    icon: @image-url("../icons/refresh-cw.svg");
                    is_active: root.active_tab == 5;
                    clicked => { root.active_tab = 5; root.tab_changed(5); }
                }

                Rectangle {}
            }
        }

        // Right Content Panel
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.surface-raised;
            clip: true;

            ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    spacing: 16px;

                    // TAB 0: ADD-ONS MANAGER
                    if root.active_tab == 0 : VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        Text {
                            text: "Add-ons Manager";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        // Install Add-on Row
                        Rectangle {
                            height: 54px;
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: center;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    height: 34px;
                                    placeholder-text: "Paste manifest URL (e.g. https://... or stremio://...)";
                                    text <=> root.install_url_input;
                                    accepted => {
                                        root.install_addon_clicked(root.install_url_input);
                                    }
                                }

                                SettingsButton {
                                    text: "Install Add-on";
                                    is_accent: true;
                                    clicked => {
                                        root.install_addon_clicked(root.install_url_input);
                                    }
                                }

                                SettingsButton {
                                    text: "Quick Setup";
                                    clicked => {
                                        root.quick_setup_clicked();
                                    }
                                }
                            }
                        }

                        // Installed Add-ons List
                        for addon in root.addon_items : Rectangle {
                            min-height: 76px;
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Text {
                                            text: addon.name;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "v" + addon.version;
                                            font-size: 11px;
                                            color: Theme.text-muted;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: addon.enabled ? 54px : 58px;
                                            height: 20px;
                                            background: addon.enabled ? #164024 : #3a2024;
                                            border-radius: 4px;
                                            Text {
                                                text: addon.enabled ? "ACTIVE" : "DISABLED";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: addon.enabled ? #3ddc84 : #ff5555;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        SettingsButton {
                                            text: "▲";
                                            min-width: 32px;
                                            height: 28px;
                                            clicked => { root.priority_addon_clicked(addon.id, true); }
                                        }

                                        SettingsButton {
                                            text: "▼";
                                            min-width: 32px;
                                            height: 28px;
                                            clicked => { root.priority_addon_clicked(addon.id, false); }
                                        }

                                        SettingsButton {
                                            text: addon.enabled ? "Disable" : "Enable";
                                            min-width: 64px;
                                            height: 28px;
                                            clicked => { root.toggle_addon_clicked(addon.id); }
                                        }

                                        SettingsButton {
                                            text: "Remove";
                                            min-width: 64px;
                                            height: 28px;
                                            clicked => { root.remove_addon_clicked(addon.id); }
                                        }
                                    }
                                }

                                Text {
                                    text: addon.description != "" ? addon.description : "No description provided.";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    max-height: 28px;
                                }
                            }
                        }
                    }

                    // TAB 1: PLAYBACK
                    if root.active_tab == 1 : VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        Text {
                            text: "Playback Settings";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        ToggleRow {
                            label: "Prefer MP4 / AAC Native Streams";
                            description: "Hardware decoded directly by Tegra 3 (zero remux overhead)";
                            checked <=> root.prefer_mp4;
                            toggled(val) => { root.prefer_mp4_toggled(val); }
                        }

                        ToggleRow {
                            label: "Auto-play Next Episode";
                            description: "Automatically start the next episode when watching a series";
                            checked <=> root.autoplay_next;
                            toggled(val) => { root.autoplay_next_toggled(val); }
                        }

                        FieldRow {
                            label: "Maximum Video Resolution";
                            description: "720p HD recommended for Surface RT Tegra 3 CPU/GPU";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ChipButton {
                                    text: "480p SD";
                                    is_active: root.max_resolution == 480;
                                    clicked => { root.max_res_changed(480); }
                                }
                                ChipButton {
                                    text: "720p HD";
                                    is_active: root.max_resolution == 720;
                                    clicked => { root.max_res_changed(720); }
                                }
                                ChipButton {
                                    text: "1080p FHD";
                                    is_active: root.max_resolution == 1080;
                                    clicked => { root.max_res_changed(1080); }
                                }
                            }
                        }

                        FieldRow {
                            label: "Default Subtitle Language";
                            description: "Preferred language for automatic subtitle selection";
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                ChipButton { text: "English (en)"; is_active: root.sub_lang == "en"; clicked => { root.sub_lang_changed("en"); } }
                                ChipButton { text: "Spanish (es)"; is_active: root.sub_lang == "es"; clicked => { root.sub_lang_changed("es"); } }
                                ChipButton { text: "French (fr)"; is_active: root.sub_lang == "fr"; clicked => { root.sub_lang_changed("fr"); } }
                                ChipButton { text: "German (de)"; is_active: root.sub_lang == "de"; clicked => { root.sub_lang_changed("de"); } }
                            }
                        }

                        FieldRow {
                            label: "Seek Button Interval";
                            description: "Jump duration for player transport forward / backward controls";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ChipButton { text: "10 seconds"; is_active: root.seek_step == 10; clicked => { root.seek_step_changed(10); } }
                                ChipButton { text: "15 seconds"; is_active: root.seek_step == 15; clicked => { root.seek_step_changed(15); } }
                                ChipButton { text: "30 seconds"; is_active: root.seek_step == 30; clicked => { root.seek_step_changed(30); } }
                            }
                        }
                    }

                    // TAB 2: STREAMING & CACHE
                    if root.active_tab == 2 : VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        Text {
                            text: "Streaming & Cache Management";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        FieldRow {
                            label: "Maximum Torrent Cache Budget";
                            description: "Oldest torrent chunks are pruned automatically by background cleaner";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ChipButton { text: "1 GB"; is_active: root.max_cache_gb == 1; clicked => { root.max_cache_changed(1); } }
                                ChipButton { text: "2 GB"; is_active: root.max_cache_gb == 2; clicked => { root.max_cache_changed(2); } }
                                ChipButton { text: "4 GB (Recommended)"; is_active: root.max_cache_gb == 4; clicked => { root.max_cache_changed(4); } }
                                ChipButton { text: "8 GB"; is_active: root.max_cache_gb == 8; clicked => { root.max_cache_changed(8); } }
                            }
                        }

                        ToggleRow {
                            label: "Keep Torrents After Playback";
                            description: "Prevents downloaded chunks from being removed upon application exit";
                            checked <=> root.keep_after_playback;
                            toggled(val) => { root.keep_playback_toggled(val); }
                        }

                        FieldRow {
                            label: "Torrent Storage Usage";
                            description: root.torrent_cache_str;
                            SettingsButton {
                                text: "Clear Torrent Chunks";
                                clicked => { root.clear_torrent_cache_clicked(); }
                            }
                        }

                        FieldRow {
                            label: "Poster Image LRU Disk Cache";
                            description: root.image_cache_str;
                            SettingsButton {
                                text: "Clear Poster Cache";
                                clicked => { root.clear_image_cache_clicked(); }
                            }
                        }
                    }

                    // TAB 3: INTERFACE
                    if root.active_tab == 3 : VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        Text {
                            text: "Interface & Appearance";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        ToggleRow {
                            label: "Reduce Animations";
                            description: "Disables smooth UI transitions to save Surface RT CPU and battery";
                            checked <=> root.reduce_animations;
                            toggled(val) => { root.reduce_anim_toggled(val); }
                        }

                        ToggleRow {
                            label: "Hero Banner Auto-Rotation";
                            description: "Cycles through featured catalog items automatically every 12s";
                            checked <=> root.hero_autorotate;
                            toggled(val) => { root.hero_rotate_toggled(val); }
                        }

                        FieldRow {
                            label: "Catalog Card Sizing";
                            description: "Controls poster density in catalog grids";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ChipButton { text: "Compact"; is_active: root.card_size == "s"; clicked => { root.card_size_changed("s"); } }
                                ChipButton { text: "Standard"; is_active: root.card_size == "m"; clicked => { root.card_size_changed("m"); } }
                                ChipButton { text: "Large"; is_active: root.card_size == "l"; clicked => { root.card_size_changed("l"); } }
                            }
                        }
                    }

                    // TAB 4: DIAGNOSTICS & LOGS
                    if root.active_tab == 4 : VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        Text {
                            text: "System Diagnostics & Live Logs";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        Rectangle {
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text {
                                    text: "Hardware Platform: " + root.platform_str;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Storage Root: " + root.storage_path_str;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Live Diagnostic Logs (" + root.log_lines.length + " entries):";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                            SettingsButton {
                                text: "Clear Logs";
                                clicked => { root.clear_logs_clicked(); }
                            }
                        }

                        Rectangle {
                            height: 280px;
                            background: #0d0e0f;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2e3034;

                            ScrollView {
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 2px;
                                    for line in root.log_lines : Text {
                                        text: line;
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }

                    // TAB 5: ABOUT
                    if root.active_tab == 5 : VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        Text {
                            text: "About Strawberry32";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }

                        Rectangle {
                            background: Theme.surface-raised;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text {
                                    text: "Strawberry32 • Modern Streaming Client for Windows RT 8.1";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: Theme.accent;
                                }

                                Text {
                                    text: "Engineered specifically for the original Microsoft Surface RT (NVIDIA Tegra 3, ARM Cortex-A9 @ 1.3 GHz, 2 GB RAM) and Windows RT 8.1.";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Key Technologies & Optimizations:\n• Pure Rust streaming engine (librqbit 8.0) with BEP 15 tracker RTT probing\n• MP4 moov & MKV Cues metadata inspector with frame-accurate OpenSubtitles videoHash\n• Media Foundation IMFMediaEngine hardware DXVA2 H.264 decoding\n• Slint pure-software software renderer with Win32 SetWindowRgn zero-overhead overlay\n• Protected LRU disk cache cleaner with configurable 4 GB budget";
                                    font-size: 12px;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }

                                Rectangle { height: 4px; }

                                Text {
                                    text: "Version 0.1.0 • Built with Rust and Slint";
                                    font-size: 11px;
                                    color: Theme.text-faint;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
