import { Theme } from "../theme.slint";
import { CatalogRow, CatalogItem } from "../components/catalog_row.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

export component SearchView inherits Rectangle {
    in-out property <string> search_text: "";
    in-out property <string> active_filter: "all";
    in-out property <string> active_genre: "all";
    in-out property <string> active_sort: "popular";
    in-out property <bool> sort_asc: false;
    in property <[CatalogItem]> movie_results: [];
    in property <[CatalogItem]> series_results: [];
    in property <[CatalogItem]> home_row1: [];
    in property <[CatalogItem]> home_row2: [];
    in property <[CatalogItem]> home_row3: [];
    in property <[CatalogItem]> home_row4: [];
    in property <bool> is_searching: false;
    in property <string> card_size: "m";

    callback search_submitted(string);
    callback filter_clicked(string);
    callback genre_clicked(string);
    callback sort_clicked(string);
    callback sort_order_toggled(bool);
    callback card_selected(string, string);
    callback request_lazy_range(int, int, int);

    background: Theme.bg;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;

        // Search Bar Row
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 0;

            search_input := LineEdit {
                placeholder-text: "Search movies, series, anime...";
                text <=> root.search_text;
                accepted => {
                    root.search_submitted(self.text);
                }
            }

            // Search Button
            Rectangle {
                width: 100px;
                height: 38px;
                background: btn_touch.pressed ? Theme.accent-pressed : (btn_touch.has-hover ? #ff709e : Theme.accent);
                border-radius: 6px;

                btn_touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.search_submitted(root.search_text);
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "🔍 Search";
                        font-size: 13px;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Filter Chips Row
        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 0;

            // All Chip
            Rectangle {
                width: 80px;
                height: 32px;
                background: root.active_filter == "all" ? Theme.accent : Theme.surface-raised;
                border-radius: 6px;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.active_filter = "all";
                        root.filter_clicked("all");
                    }
                }

                Text {
                    text: "All";
                    font-size: 12px;
                    font-weight: root.active_filter == "all" ? 700 : 500;
                    color: root.active_filter == "all" ? #ffffff : Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Movies Chip
            Rectangle {
                width: 80px;
                height: 32px;
                background: root.active_filter == "movie" ? Theme.accent : Theme.surface-raised;
                border-radius: 6px;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.active_filter = "movie";
                        root.filter_clicked("movie");
                    }
                }

                Text {
                    text: "Movies";
                    font-size: 12px;
                    font-weight: root.active_filter == "movie" ? 700 : 500;
                    color: root.active_filter == "movie" ? #ffffff : Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Series Chip
            Rectangle {
                width: 80px;
                height: 32px;
                background: root.active_filter == "series" ? Theme.accent : Theme.surface-raised;
                border-radius: 6px;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.active_filter = "series";
                        root.filter_clicked("series");
                    }
                }

                Text {
                    text: "Series";
                    font-size: 12px;
                    font-weight: root.active_filter == "series" ? 700 : 500;
                    color: root.active_filter == "series" ? #ffffff : Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Secondary Controls: Genre Filter & Sort By
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 0;
            alignment: space-between;

            // Genre Selector
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: "Genre:";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }

                for g in [
                    { id: "all", label: "All" },
                    { id: "action", label: "Action" },
                    { id: "comedy", label: "Comedy" },
                    { id: "drama", label: "Drama" },
                    { id: "sci-fi", label: "Sci-Fi" },
                    { id: "horror", label: "Horror" },
                    { id: "animation", label: "Animation" },
                    { id: "thriller", label: "Thriller" }
                ] : Rectangle {
                    height: 26px;
                    background: root.active_genre == g.id ? Theme.accent : Theme.surface-raised;
                    border-radius: 4px;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.active_genre = g.id;
                            root.genre_clicked(g.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: g.label;
                            font-size: 11px;
                            font-weight: root.active_genre == g.id ? 700 : 500;
                            color: root.active_genre == g.id ? #ffffff : Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Sort By Selector
            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                Text {
                    text: "Sort:";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }

                for s in [
                    { id: "popular", label: "Popular" },
                    { id: "rating", label: "Rating ★" },
                    { id: "year", label: "Year 📅" },
                    { id: "title", label: "Title A-Z" }
                ] : Rectangle {
                    height: 26px;
                    background: root.active_sort == s.id ? Theme.accent : Theme.surface-raised;
                    border-radius: 4px;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.active_sort = s.id;
                            root.sort_clicked(s.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: s.label;
                            font-size: 11px;
                            font-weight: root.active_sort == s.id ? 700 : 500;
                            color: root.active_sort == s.id ? #ffffff : Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Ascending / Descending Toggle
                Rectangle {
                    height: 26px;
                    background: root.sort_asc ? Theme.accent : Theme.surface-raised;
                    border-radius: 4px;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.sort_asc = !root.sort_asc;
                            root.sort_order_toggled(root.sort_asc);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: root.sort_asc ? "▲ Asc" : "▼ Desc";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.sort_asc ? #ffffff : Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Search Content / Results
        if root.is_searching : Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            border-radius: 8px;
            Text {
                text: "Searching Cinemeta & Stremio Addons...";
                font-size: 14px;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !root.is_searching && root.search_text != "" && root.movie_results.length == 0 && root.series_results.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            border-radius: 8px;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "No results found for \"" + root.search_text + "\"";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Try searching with a different keyword or genre filter";
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        if !root.is_searching && (root.movie_results.length > 0 || root.series_results.length > 0) : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 20px;
                padding-bottom: 24px;

                if (root.active_filter == "all" || root.active_filter == "movie") && root.movie_results.length > 0 : CatalogRow {
                    title: "Movies (" + root.movie_results.length + " titles)";
                    items: root.movie_results;
                    row_index: 10;
                    card_size: root.card_size;
                    card_clicked(id, type) => {
                        root.card_selected(id, type);
                    }
                    request_lazy_range(row, start, end) => {
                        root.request_lazy_range(row, start, end);
                    }
                }

                if (root.active_filter == "all" || root.active_filter == "series") && root.series_results.length > 0 : CatalogRow {
                    title: "Series (" + root.series_results.length + " titles)";
                    items: root.series_results;
                    row_index: 11;
                    card_size: root.card_size;
                    card_clicked(id, type) => {
                        root.card_selected(id, type);
                    }
                    request_lazy_range(row, start, end) => {
                        root.request_lazy_range(row, start, end);
                    }
                }
            }
        }

        // Default Discover State (when search query is empty) - Never blank!
        if !root.is_searching && root.search_text == "" && root.movie_results.length == 0 && root.series_results.length == 0 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 20px;
                padding-bottom: 24px;

                Rectangle {
                    height: 30px;
                    background: #00000000;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Text {
                            text: "✨ Explore Categories";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "— or type in the search bar above to search full library";
                            font-size: 12px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                if (root.active_filter == "all" || root.active_filter == "movie") && root.home_row1.length > 0 : CatalogRow {
                    title: "Popular Movies";
                    items: root.home_row1;
                    row_index: 0;
                    card_size: root.card_size;
                    card_clicked(id, type) => {
                        root.card_selected(id, type);
                    }
                    request_lazy_range(row, start, end) => {
                        root.request_lazy_range(row, start, end);
                    }
                }

                if (root.active_filter == "all" || root.active_filter == "series") && root.home_row2.length > 0 : CatalogRow {
                    title: "Top Series";
                    items: root.home_row2;
                    row_index: 1;
                    card_size: root.card_size;
                    card_clicked(id, type) => {
                        root.card_selected(id, type);
                    }
                    request_lazy_range(row, start, end) => {
                        root.request_lazy_range(row, start, end);
                    }
                }

                if (root.active_filter == "all" || root.active_filter == "movie") && root.home_row3.length > 0 : CatalogRow {
                    title: "Trending Sci-Fi & Fantasy";
                    items: root.home_row3;
                    row_index: 2;
                    card_size: root.card_size;
                    card_clicked(id, type) => {
                        root.card_selected(id, type);
                    }
                    request_lazy_range(row, start, end) => {
                        root.request_lazy_range(row, start, end);
                    }
                }

                if (root.active_filter == "all" || root.active_filter == "movie") && root.home_row4.length > 0 : CatalogRow {
                    title: "Action & Thriller";
                    items: root.home_row4;
                    row_index: 3;
                    card_size: root.card_size;
                    card_clicked(id, type) => {
                        root.card_selected(id, type);
                    }
                    request_lazy_range(row, start, end) => {
                        root.request_lazy_range(row, start, end);
                    }
                }
            }
        }
    }
}
