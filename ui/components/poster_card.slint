import { Theme } from "../theme.slint";

export component PosterCard inherits Rectangle {
    in property <string> id: "";
    in property <string> title: "";
    in property <string> year: "";
    in property <string> item_type: "movie";
    in property <image> poster;
    in property <bool> has_poster: false;
    in property <string> card_size: "m";

    callback clicked(string, string);

    width: root.card_size == "s" ? 116px : (root.card_size == "l" ? 162px : 138px);
    height: root.card_size == "s" ? 210px : (root.card_size == "l" ? 284px : 246px);
    background: touch.pressed ? Theme.surface-raised : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    border-radius: 8px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.surface-raised;
    clip: true;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked(root.id, root.item_type);
        }
    }

    VerticalLayout {
        padding: 4px;
        spacing: 6px;

        // Poster image area
        Rectangle {
            width: root.card_size == "s" ? 108px : (root.card_size == "l" ? 154px : 130px);
            height: root.card_size == "s" ? 164px : (root.card_size == "l" ? 232px : 196px);
            background: Theme.surface-raised;
            border-radius: 6px;
            clip: true;

            if root.has_poster : Image {
                source: root.poster;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.has_poster : VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: root.item_type == "movie" ? "🎬" : "📺";
                    font-size: root.card_size == "s" ? 22px : 28px;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.title != "" ? root.title : "...";
                    font-size: root.card_size == "s" ? 10px : 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Title and Year / Type subtitle
        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            alignment: space-between;

            Text {
                text: root.title;
                font-size: root.card_size == "s" ? 11px : (root.card_size == "l" ? 13px : 12px);
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            if root.year != "" : Text {
                text: root.year;
                font-size: root.card_size == "s" ? 9px : 10px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }
}

