import { Theme } from "../theme.slint";

export component PosterCard inherits Rectangle {
    in property <string> id: "";
    in property <string> title: "";
    in property <string> year: "";
    in property <string> item_type: "movie";
    in property <image> poster;
    in property <bool> has_poster: false;

    callback clicked(string, string);

    width: 146px;
    height: 255px;
    background: touch.pressed ? Theme.surface-raised : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    border-radius: 8px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.surface-raised;
    clip: true;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked(root.id, root.item_type);
        }
    }

    VerticalLayout {
        padding: 4px;
        spacing: 6px;

        // Poster image area (2:3 aspect ratio: 138px x 207px)
        Rectangle {
            width: 138px;
            height: 207px;
            background: Theme.surface-raised;
            border-radius: 6px;
            clip: true;

            if root.has_poster : Image {
                source: root.poster;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.has_poster : VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: root.item_type == "movie" ? "🎬" : "📺";
                    font-size: 28px;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.title != "" ? root.title : "...";
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Title and Year / Type subtitle
        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            alignment: space-between;

            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            if root.year != "" : Text {
                text: root.year;
                font-size: 10px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }
}

