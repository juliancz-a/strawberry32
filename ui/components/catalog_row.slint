import { Theme } from "../theme.slint";
import { PosterCard } from "poster_card.slint";

export struct CatalogItem {
    id: string,
    title: string,
    year: string,
    item_type: string,
    poster: image,
    has_poster: bool,
}

component ChevronButton inherits Rectangle {
    in property <string> text: "";
    callback clicked();

    width: 34px;
    height: 28px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: touch.pressed ? Theme.accent : (touch.has-hover ? #2a2b2e : #1c1d20);
    border-width: 1px;
    border-color: touch.has-hover ? #505258 : #333438;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CatalogRow inherits VerticalLayout {
    in property <string> title: "Catalog Row";
    in property <[CatalogItem]> items: [];
    in property <int> row_index: 0;
    in property <string> card_size: "m";
    in property <string> page_indicator: "";
    in property <int> cards_per_row: 7;

    property <length> card_w: root.card_size == "s" ? 116px : (root.card_size == "l" ? 162px : 138px);
    property <length> card_spacing: 10px;
    property <length> card_slot_w: root.card_w + root.card_spacing;
    property <length> row_height: root.card_size == "s" ? 256px : (root.card_size == "l" ? 330px : 292px);

    // Full row width matching the exact span from card 1 to card N
    property <length> full_row_width: max(root.card_w, max(1, root.cards_per_row) * root.card_slot_w - root.card_spacing);

    callback card_clicked(string, string);
    callback request_lazy_range(int, int, int);
    callback prev_page(int);
    callback next_page(int);

    // Centered outer container keeping equal left and right margins across the view
    HorizontalLayout {
        alignment: center;

        // Card container element: both the header (title & buttons) and the cards are constrained to this width
        VerticalLayout {
            width: root.full_row_width;
            spacing: 8px;

            // Row Header: limited to the exact bounds of the cards container
            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: root.title;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if root.page_indicator != "" : Text {
                        text: root.page_indicator;
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    ChevronButton {
                        text: "◀";
                        clicked => {
                            root.prev_page(root.row_index);
                        }
                    }

                    ChevronButton {
                        text: "▶";
                        clicked => {
                            root.next_page(root.row_index);
                        }
                    }
                }
            }

            // Fixed horizontal viewport displaying cards: aligned to the left (flex layout) inside the card container element
            HorizontalLayout {
                height: root.row_height;
                spacing: 10px;
                alignment: start;

                for item in root.items : PosterCard {
                    id: item.id;
                    title: item.title;
                    year: item.year;
                    item_type: item.item_type;
                    poster: item.poster;
                    has_poster: item.has_poster;
                    card_size: root.card_size;

                    clicked(id, type) => {
                        root.card_clicked(id, type);
                    }
                }
            }
        }
    }
}
