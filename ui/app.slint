import { Theme } from "theme.slint";
import { PlayerOverlay } from "overlay/player_overlay.slint";
import { PosterCard } from "components/poster_card.slint";
import { CatalogRow, CatalogItem } from "components/catalog_row.slint";
import { Sidebar } from "components/sidebar.slint";
import { HeroBanner } from "components/hero_banner.slint";
import { DetailView, StreamItem, EpisodeItem } from "views/detail_view.slint";
import { SearchView } from "views/search_view.slint";
import { LibraryView } from "views/library_view.slint";
import { SettingsView, AddonItem } from "views/settings_view.slint";
import { ScrollView } from "std-widgets.slint";

export { Theme, PlayerOverlay, CatalogItem, StreamItem, EpisodeItem, AddonItem }

export component MainWindow inherits Window {
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 860px;
    min-height: 560px;
    title: "Strawberry32 - Surface RT (ARM32)";
    icon: @image-url("icons/brand/strawberry32-icon-color.svg");
    background: Theme.bg;

    // Startup Splash State
    in-out property <bool> is_app_initializing: true;

    // View state: 0 = Home, 1 = Detail, 2 = Player, 3 = Search, 4 = Library, 5 = Settings
    in-out property <int> current_view: 0;

    // Top Bar / Status
    in-out property <string> status_text: "Ready. Browse featured titles or search.";

    // Continue Watching Model
    in-out property <bool> has_continue_watching: false;
    in-out property <[CatalogItem]> home_continue_watching: [];

    // Hero Model
    in-out property <string> hero_title: "Featured Title";
    in-out property <string> hero_meta: "2025 • Trending Now • ★ 8.4 • HD";
    in-out property <string> hero_desc: "Stream your favorite movies and series directly on Windows RT with hardware acceleration.";
    in-out property <string> hero_id: "";
    in-out property <string> hero_type: "movie";
    in-out property <image> hero_backdrop;
    in-out property <bool> has_hero_backdrop: false;
    in-out property <int> hero_index: 0;
    in-out property <int> hero_total: 5;

    // Catalog Model (Home 6 distinct rows)
    in-out property <bool> is_catalog_loading: false;
    in-out property <[CatalogItem]> home_row1: [];
    in-out property <[CatalogItem]> home_row2: [];
    in-out property <[CatalogItem]> home_row3: [];
    in-out property <[CatalogItem]> home_row4: [];
    in-out property <[CatalogItem]> home_row5: [];
    in-out property <[CatalogItem]> home_row6: [];
    in-out property <string> home_row1_indicator: "";
    in-out property <string> home_row2_indicator: "";
    in-out property <string> home_row3_indicator: "";
    in-out property <string> home_row4_indicator: "";
    in-out property <string> home_row5_indicator: "";
    in-out property <string> home_row6_indicator: "";
    callback home_row_prev_page(int);
    callback home_row_next_page(int);

    // Search Model
    in-out property <string> search_text: "";
    in-out property <string> active_filter: "all";
    in-out property <[CatalogItem]> search_movie_results: [];
    in-out property <[CatalogItem]> search_series_results: [];
    in-out property <bool> is_searching: false;

    // Library Model
    in-out property <[CatalogItem]> library_items: [];

    // Detail Model
    in-out property <string> detail_id: "";
    in-out property <string> detail_title: "";
    in-out property <string> detail_type: "";
    in-out property <string> detail_year: "";
    in-out property <string> detail_desc: "";
    in-out property <image> detail_poster;
    in-out property <image> detail_backdrop;
    in-out property <bool> has_detail_backdrop: false;
    in-out property <image> detail_logo;
    in-out property <bool> has_detail_logo: false;
    in-out property <bool> detail_is_series: false;
    in-out property <string> detail_imdb_rating: "";
    in-out property <string> detail_runtime: "";
    in-out property <string> detail_genres: "";
    in-out property <string> detail_cast: "";
    in-out property <string> detail_director: "";

    // Series episode selector properties
    in-out property <[int]> seasons_list: [];
    in-out property <int> selected_season: 1;
    in-out property <int> selected_episode: 1;
    in-out property <string> selected_episode_title: "";
    in-out property <string> selected_episode_overview: "";
    in-out property <string> selected_episode_released: "";
    in-out property <[EpisodeItem]> episode_items: [];

    in-out property <[StreamItem]> stream_items: [];
    in-out property <bool> is_streams_loading: false;

    // Player View Model
    in-out property <bool> is_player_loading: false;
    in-out property <int> player_loading_stage: 1; // 1=Peers, 2=Meta, 3=Container, 4=Index, 5=Buffering, 6=Decoder, 7=Ready
    in-out property <bool> player_show_details: false;
    in-out property <[string]> player_loading_events: [];
    in-out property <bool> player_has_hint: false;
    in-out property <string> player_hint_msg: "";
    in-out property <string> player_title: "";
    in-out property <string> player_status_msg: "";
    in-out property <string> player_peers_str: "";
    in-out property <string> player_speed_str: "";
    in-out property <string> player_progress_str: "";
    in-out property <float> player_progress_val: 0.0;
    in-out property <string> time_str: "--:-- / --:--";
    in-out property <string> subtitle_text: "";
    in-out property <bool> is_paused: false;
    in-out property <bool> is_fullscreen: false;
    in-out property <bool> overlay_failed: false;
    in-out property <bool> player_has_error: false;
    in-out property <string> player_error_msg: "";

    // Diagnostic Logs & Crash Reporting
    in-out property <[string]> log_lines: [];
    in-out property <bool> has_crash_report: false;

    // Settings Model
    in-out property <int> settings_active_tab: 0;
    in-out property <[AddonItem]> settings_addon_items: [];
    in-out property <int> settings_max_res: 720;
    in-out property <bool> settings_prefer_mp4: true;
    in-out property <string> settings_sub_lang: "en";
    in-out property <string> settings_audio_lang: "en";
    in-out property <bool> settings_autoplay_next: true;
    in-out property <int> settings_seek_step: 15;
    in-out property <string> settings_torrent_cache_str: "0 MB / 2048 MB";
    in-out property <string> settings_image_cache_str: "0 MB / 48 MB";
    in-out property <int> settings_max_cache_gb: 2;
    in-out property <bool> settings_keep_playback: false;
    in-out property <bool> settings_reduce_anim: false;
    in-out property <bool> settings_hero_rotate: true;
    in-out property <string> settings_card_size: "m";
    in-out property <string> settings_storage_path: "";

    // Search and Stream Filter/Sort State
    in-out property <string> search_genre: "all";
    in-out property <string> search_sort: "popular";
    in-out property <bool> search_sort_asc: false;

    in-out property <string> detail_stream_format: "all";
    in-out property <string> detail_stream_res: "all";
    in-out property <string> detail_stream_sort: "compat";
    in-out property <bool> detail_stream_sort_asc: false;

    // Callbacks to Rust
    callback search_submitted(string);
    callback filter_clicked(string);
    callback search_genre_clicked(string);
    callback search_sort_clicked(string);
    callback search_sort_order_toggled(bool);
    callback detail_stream_filter_format(string);
    callback detail_stream_filter_res(string);
    callback detail_stream_sort_by(string);
    callback detail_stream_sort_order(bool);
    callback reload_home_catalog();
    callback player_toggle_details();
    callback open_logs_folder();
    callback copy_diagnostics();
    callback dismiss_crash_report();
    callback clear_logs();
    callback clear_watch_history();

    callback settings_tab_changed(int);
    callback settings_install_addon(string);
    callback settings_toggle_addon(string);
    callback settings_remove_addon(string);
    callback settings_priority_addon(string, bool);
    callback settings_change_max_res(int);
    callback settings_change_prefer_mp4(bool);
    callback settings_change_sub_lang(string);
    callback settings_change_audio_lang(string);
    callback settings_change_autoplay_next(bool);
    callback settings_change_seek_step(int);
    callback settings_change_max_cache(int);
    callback settings_change_keep_playback(bool);
    callback settings_clear_torrent_cache();
    callback settings_clear_image_cache();
    callback settings_change_reduce_anim(bool);
    callback settings_change_hero_rotate(bool);
    callback settings_change_card_size(string);

    callback card_selected(string, string);
    callback back_to_catalog();
    callback fetch_episode_streams(string, int, int);
    callback season_selected(int);
    callback request_lazy_range(int, int, int);

    callback hero_prev();
    callback hero_next();

    callback play_stream_clicked(int);
    callback play_vlc_clicked(int);

    callback player_back();
    callback player_play_pause();
    callback player_seek_backward();
    callback player_seek_forward();
    callback player_cycle_subtitles();
    callback player_toggle_fullscreen();
    callback player_open_vlc();
    callback handle_key_escape();

    forward-focus: main_focus;
    main_focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.handle_key_escape();
                return accept;
            }
            if (event.text == "f" || event.text == "F" || event.text == Key.F11) {
                root.player_toggle_fullscreen();
                return accept;
            }
            if (event.text == " ") {
                root.player_play_pause();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.player_seek_backward();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.player_seek_forward();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg;

            // CONTENT AREA
            Rectangle {
                x: (root.current_view == 2 ? 0px : 56px);
                y: 0px;
                width: parent.width - (root.current_view == 2 ? 0px : 56px);
                height: parent.height;

                // VIEW 0: HOME / DISCOVER VIEW
                if root.current_view == 0 : Rectangle {
                    background: Theme.bg;

                    ScrollView {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 18px;

                            // Hero Banner
                            HeroBanner {
                                title: root.hero_title != "" ? root.hero_title : "Welcome to Strawberry32";
                                meta_line: root.hero_meta != "" ? root.hero_meta : "Hardware Accelerated Streaming on Windows RT";
                                description: root.hero_desc != "" ? root.hero_desc : "Select any popular movie or series below to begin playback with hardware H.264 decoding.";
                                item_id: root.hero_id;
                                item_type: root.hero_type;
                                backdrop: root.hero_backdrop;
                                has_backdrop: root.has_hero_backdrop;
                                hero_index: root.hero_index;
                                hero_total: root.hero_total;

                                play_clicked(id, itype) => {
                                    if (id != "") { root.card_selected(id, itype); }
                                }
                                details_clicked(id, itype) => {
                                    if (id != "") { root.card_selected(id, itype); }
                                }
                                prev_clicked => { root.hero_prev(); }
                                next_clicked => { root.hero_next(); }
                            }

                            // Loading state
                            if root.is_catalog_loading : Rectangle {
                                height: 100px;
                                background: Theme.surface;
                                border-radius: 8px;
                                Text {
                                    text: "Loading catalog from Cinemeta...";
                                    font-size: 15px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Continue Watching Row (Phase D feature)
                            if !root.is_catalog_loading && root.has_continue_watching && root.home_continue_watching.length > 0 : CatalogRow {
                                title: "▶ Continue Watching";
                                items: root.home_continue_watching;
                                row_index: 99;
                                card_size: root.settings_card_size;
                                page_indicator: "";
                                card_clicked(id, type) => { root.card_selected(id, type); }
                                request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                                prev_page(row) => {}
                                next_page(row) => {}
                            }

                            // Empty State
                            if !root.is_catalog_loading && root.home_row1.length == 0 : Rectangle {
                                height: 160px;
                                background: Theme.surface;
                                border-radius: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    Text {
                                        text: "Featured Cinemeta catalogs loading or not available.";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 180px;
                                            height: 36px;
                                            background: qk_touch.pressed ? Theme.accent-pressed : (qk_touch.has-hover ? #ff709e : Theme.accent);
                                            border-radius: 6px;
                                            qk_touch := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                mouse-cursor: pointer;
                                                clicked => { root.reload_home_catalog(); }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Reload Catalogs";
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 6 Distinct Home Catalog Rows
                            if !root.is_catalog_loading && root.home_row1.length > 0 : CatalogRow {
                                title: "Popular Movies";
                                items: root.home_row1;
                                row_index: 0;
                                card_size: root.settings_card_size;
                                page_indicator: root.home_row1_indicator;
                                card_clicked(id, type) => { root.card_selected(id, type); }
                                request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                                prev_page(row) => { root.home_row_prev_page(row); }
                                next_page(row) => { root.home_row_next_page(row); }
                            }

                            if !root.is_catalog_loading && root.home_row2.length > 0 : CatalogRow {
                                title: "Trending Series";
                                items: root.home_row2;
                                row_index: 1;
                                card_size: root.settings_card_size;
                                page_indicator: root.home_row2_indicator;
                                card_clicked(id, type) => { root.card_selected(id, type); }
                                request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                                prev_page(row) => { root.home_row_prev_page(row); }
                                next_page(row) => { root.home_row_next_page(row); }
                            }

                            if !root.is_catalog_loading && root.home_row3.length > 0 : CatalogRow {
                                title: "Action & Adventure";
                                items: root.home_row3;
                                row_index: 2;
                                card_size: root.settings_card_size;
                                page_indicator: root.home_row3_indicator;
                                card_clicked(id, type) => { root.card_selected(id, type); }
                                request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                                prev_page(row) => { root.home_row_prev_page(row); }
                                next_page(row) => { root.home_row_next_page(row); }
                            }

                            if !root.is_catalog_loading && root.home_row4.length > 0 : CatalogRow {
                                title: "Top Sci-Fi & Fantasy";
                                items: root.home_row4;
                                row_index: 3;
                                card_size: root.settings_card_size;
                                page_indicator: root.home_row4_indicator;
                                card_clicked(id, type) => { root.card_selected(id, type); }
                                request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                                prev_page(row) => { root.home_row_prev_page(row); }
                                next_page(row) => { root.home_row_next_page(row); }
                            }

                            if !root.is_catalog_loading && root.home_row5.length > 0 : CatalogRow {
                                title: "Comedy Hits";
                                items: root.home_row5;
                                row_index: 4;
                                card_size: root.settings_card_size;
                                page_indicator: root.home_row5_indicator;
                                card_clicked(id, type) => { root.card_selected(id, type); }
                                request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                                prev_page(row) => { root.home_row_prev_page(row); }
                                next_page(row) => { root.home_row_next_page(row); }
                            }

                            if !root.is_catalog_loading && root.home_row6.length > 0 : CatalogRow {
                                title: "Crime & Drama";
                                items: root.home_row6;
                                row_index: 5;
                                card_size: root.settings_card_size;
                                page_indicator: root.home_row6_indicator;
                                card_clicked(id, type) => { root.card_selected(id, type); }
                                request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                                prev_page(row) => { root.home_row_prev_page(row); }
                                next_page(row) => { root.home_row_next_page(row); }
                            }
                        }
                    }
                }

                // VIEW 1: DETAIL VIEW
                if root.current_view == 1 : DetailView {
                    detail_id: root.detail_id;
                    detail_title: root.detail_title;
                    detail_type: root.detail_type;
                    detail_year: root.detail_year;
                    detail_desc: root.detail_desc;
                    detail_poster: root.detail_poster;
                    detail_backdrop: root.detail_backdrop;
                    has_detail_backdrop: root.has_detail_backdrop;
                    detail_is_series: root.detail_is_series;
                    detail_imdb_rating: root.detail_imdb_rating;
                    detail_runtime: root.detail_runtime;
                    detail_genres: root.detail_genres;
                    detail_cast: root.detail_cast;
                    detail_director: root.detail_director;

                    seasons_list: root.seasons_list;
                    selected_season <=> root.selected_season;
                    selected_episode <=> root.selected_episode;
                    selected_episode_title <=> root.selected_episode_title;
                    selected_episode_overview <=> root.selected_episode_overview;
                    selected_episode_released <=> root.selected_episode_released;
                    episode_items: root.episode_items;

                    stream_items: root.stream_items;
                    is_streams_loading: root.is_streams_loading;
                    stream_filter_format <=> root.detail_stream_format;
                    stream_filter_res <=> root.detail_stream_res;
                    stream_sort_by <=> root.detail_stream_sort;
                    stream_sort_asc <=> root.detail_stream_sort_asc;

                    back_clicked => { root.back_to_catalog(); }
                    play_stream_clicked(idx) => { root.play_stream_clicked(idx); }
                    play_vlc_clicked(idx) => { root.play_vlc_clicked(idx); }
                    fetch_episode_streams(id, s, e) => { root.fetch_episode_streams(id, s, e); }
                    season_selected(s) => { root.season_selected(s); }
                    stream_filter_format_changed(fmt) => {
                        root.detail_stream_format = fmt;
                        root.detail_stream_filter_format(fmt);
                    }
                    stream_filter_res_changed(res) => {
                        root.detail_stream_res = res;
                        root.detail_stream_filter_res(res);
                    }
                    stream_sort_by_changed(s) => {
                        root.detail_stream_sort = s;
                        root.detail_stream_sort_by(s);
                    }
                    stream_sort_order_toggled(asc) => {
                        root.detail_stream_sort_asc = asc;
                        root.detail_stream_sort_order(asc);
                    }
                    open_addons_clicked => {
                        root.current_view = 5;
                        root.settings_active_tab = 0;
                    }
                    retry_streams_clicked => {
                        root.fetch_episode_streams(root.detail_id, root.selected_season, root.selected_episode);
                    }
                    play_best_match => {
                        if (root.stream_items.length > 0) {
                            root.play_stream_clicked(0);
                        }
                    }
                }

                // VIEW 2: EMBEDDED PLAYER VIEW
                if root.current_view == 2 : Rectangle {
                    background: #000000;

                    // In-Player Polished Nuvio Loading Overlay
                    if root.is_player_loading : Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #0b0b0e;

                        // Full-bleed backdrop if present (brighter and clearly visible)
                        if root.has_detail_backdrop : Image {
                            width: 100%;
                            height: 100%;
                            source: root.detail_backdrop;
                            image-fit: cover;
                            opacity: 0.65;
                        }

                        // Gentle gradient/scrim overlay
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: #0b0b0e50;
                        }

                        // Top bar
                        HorizontalLayout {
                            y: 16px;
                            x: 20px;
                            width: parent.width - 40px;
                            height: 40px;
                            alignment: space-between;

                            // Left Back Pill Button
                            Rectangle {
                                width: 92px;
                                height: 36px;
                                border-radius: 18px;
                                background: load_back_touch.pressed ? #33333d : (load_back_touch.has-hover ? #25252c : #18181f);
                                border-width: 1px;
                                border-color: load_back_touch.has-hover ? Theme.accent : #2a2a35;

                                load_back_touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.player_back(); }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "← Back";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Top Right Fullscreen Pill Button (Clearly labeled & distinct)
                            Rectangle {
                                width: 110px;
                                height: 36px;
                                border-radius: 18px;
                                background: load_fs_touch.pressed ? #33333d : (load_fs_touch.has-hover ? #25252c : #18181f);
                                border-width: 1px;
                                border-color: load_fs_touch.has-hover ? Theme.accent : #2a2a35;

                                load_fs_touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.player_toggle_fullscreen(); }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 14px;
                                            height: 14px;
                                            stroke: #ffffff;
                                            stroke-width: 1.8px;
                                            commands: root.is_fullscreen
                                                ? "M 5 2 L 5 5 L 2 5 M 9 2 L 9 5 L 12 5 M 12 9 L 9 9 L 9 12 M 2 9 L 5 9 L 5 12"
                                                : "M 2 5 L 2 2 L 5 2 M 9 2 L 12 2 L 12 5 M 12 9 L 12 12 L 9 12 M 5 12 L 2 12 L 2 9";
                                        }
                                    }

                                    Text {
                                        text: root.is_fullscreen ? "Restore" : "Fullscreen";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Centered Stream Telemetry & Title
                        VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            alignment: center;
                            spacing: 12px;

                            // Title graphic logo if available, or Strawberry32 brand logo + bold title text
                            HorizontalLayout {
                                alignment: center;
                                if root.has_detail_logo : Image {
                                    source: root.detail_logo;
                                    height: 70px;
                                    image-fit: contain;
                                    horizontal-alignment: center;
                                }
                                if !root.has_detail_logo : VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/brand/strawberry32-color.svg");
                                            width: 84px;
                                            height: 84px;
                                            image-fit: contain;
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: root.player_title != "" ? root.player_title : "Buffering Stream";
                                            font-size: 26px;
                                            font-weight: 800;
                                            color: #ffffff;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                            max-width: 780px;
                                        }
                                    }
                                }
                            }

                            if root.detail_is_series && root.selected_episode_title != "" : HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "S" + root.selected_season + ":E" + root.selected_episode + " • " + root.selected_episode_title;
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    horizontal-alignment: center;
                                }
                            }

                            Rectangle { height: 6px; }

                            // Stage Checklist (Phase B #7)
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;

                                // 1. Peers
                                Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.player_loading_stage >= 1 ? #25262e : #141418;
                                    border-width: 1px;
                                    border-color: root.player_loading_stage == 1 ? Theme.accent : (root.player_loading_stage > 1 ? #3a3b45 : #1e1f26);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: root.player_loading_stage > 1 ? "✓" : (root.player_loading_stage == 1 ? "●" : "○");
                                            font-size: 10px;
                                            color: root.player_loading_stage >= 1 ? Theme.accent : Theme.text-faint;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Peers";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.player_loading_stage >= 1 ? #ffffff : Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 2. Metadata
                                Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.player_loading_stage >= 2 ? #25262e : #141418;
                                    border-width: 1px;
                                    border-color: root.player_loading_stage == 2 ? Theme.accent : (root.player_loading_stage > 2 ? #3a3b45 : #1e1f26);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: root.player_loading_stage > 2 ? "✓" : (root.player_loading_stage == 2 ? "●" : "○");
                                            font-size: 10px;
                                            color: root.player_loading_stage >= 2 ? Theme.accent : Theme.text-faint;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Meta";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.player_loading_stage >= 2 ? #ffffff : Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 3. Container
                                Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.player_loading_stage >= 3 ? #25262e : #141418;
                                    border-width: 1px;
                                    border-color: root.player_loading_stage == 3 ? Theme.accent : (root.player_loading_stage > 3 ? #3a3b45 : #1e1f26);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: root.player_loading_stage > 3 ? "✓" : (root.player_loading_stage == 3 ? "●" : "○");
                                            font-size: 10px;
                                            color: root.player_loading_stage >= 3 ? Theme.accent : Theme.text-faint;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Container";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.player_loading_stage >= 3 ? #ffffff : Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 4. Index
                                Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.player_loading_stage >= 4 ? #25262e : #141418;
                                    border-width: 1px;
                                    border-color: root.player_loading_stage == 4 ? Theme.accent : (root.player_loading_stage > 4 ? #3a3b45 : #1e1f26);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: root.player_loading_stage > 4 ? "✓" : (root.player_loading_stage == 4 ? "●" : "○");
                                            font-size: 10px;
                                            color: root.player_loading_stage >= 4 ? Theme.accent : Theme.text-faint;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Index";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.player_loading_stage >= 4 ? #ffffff : Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 5. Buffer
                                Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.player_loading_stage >= 5 ? #25262e : #141418;
                                    border-width: 1px;
                                    border-color: root.player_loading_stage == 5 ? Theme.accent : (root.player_loading_stage > 5 ? #3a3b45 : #1e1f26);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: root.player_loading_stage > 5 ? "✓" : (root.player_loading_stage == 5 ? "●" : "○");
                                            font-size: 10px;
                                            color: root.player_loading_stage >= 5 ? Theme.accent : Theme.text-faint;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Buffer";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.player_loading_stage >= 5 ? #ffffff : Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 6. Decoder
                                Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.player_loading_stage >= 6 ? #25262e : #141418;
                                    border-width: 1px;
                                    border-color: root.player_loading_stage == 6 ? Theme.accent : (root.player_loading_stage > 6 ? #3a3b45 : #1e1f26);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: root.player_loading_stage > 6 ? "✓" : (root.player_loading_stage == 6 ? "●" : "○");
                                            font-size: 10px;
                                            color: root.player_loading_stage >= 6 ? Theme.accent : Theme.text-faint;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Decoder";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.player_loading_stage >= 6 ? #ffffff : Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Truthful Weighted Progress Bar
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 380px;
                                    height: 5px;
                                    background: #23232a;
                                    border-radius: 2.5px;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 100%;
                                        width: max(0.02, min(1.0, root.player_progress_val)) * parent.width;
                                        background: Theme.accent;
                                        border-radius: 2.5px;
                                    }
                                }
                            }

                            // Telemetry line (peers • speed • progress • ETA)
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: (root.player_peers_str != "" ? root.player_peers_str : "0 peers") + " • " +
                                          (root.player_speed_str != "" ? root.player_speed_str : "0 KB/s") + " • " +
                                          (root.player_progress_str != "" ? root.player_progress_str : "0.0 MB");
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: #a0a0ab;
                                    horizontal-alignment: center;
                                }
                            }

                            // Smart hint banner when few peers detected after 15s
                            if root.player_has_hint : HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    background: #261b16;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #854d0e;
                                    height: 32px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        alignment: center;
                                        Text {
                                            text: "⚠ " + (root.player_hint_msg != "" ? root.player_hint_msg : "Few peers detected. Try another source.");
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #fbbf24;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 90px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: hint_btn.pressed ? #a16207 : #ca8a04;
                                            hint_btn := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                mouse-cursor: pointer;
                                                clicked => { root.player_back(); }
                                            }
                                            Text {
                                                text: "Pick Stream";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Dedicated Error Card when stream playback or decoder fails
                            if root.player_has_error : HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    background: #231215;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #ef4444;
                                    width: min(540px, parent.width - 40px);

                                    VerticalLayout {
                                        padding-top: 14px;
                                        padding-bottom: 14px;
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 12px;
                                        alignment: center;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text {
                                                text: "⚠";
                                                font-size: 16px;
                                                color: #ef4444;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Playback / Decoder Error";
                                                font-size: 15px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: root.player_error_msg != "" ? root.player_error_msg : root.player_status_msg;
                                            font-size: 12px;
                                            color: #e2e8f0;
                                            wrap: word-wrap;
                                            horizontal-alignment: center;
                                        }

                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: center;

                                            // Play in VLC button
                                            Rectangle {
                                                width: 150px;
                                                height: 36px;
                                                border-radius: 6px;
                                                background: vlc_err_btn.pressed ? #c2410c : (vlc_err_btn.has-hover ? #f97316 : #ea580c);
                                                vlc_err_btn := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.player_open_vlc(); }
                                                }
                                                Text {
                                                    text: "▶ Play in VLC";
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Back to detail button
                                            Rectangle {
                                                width: 120px;
                                                height: 36px;
                                                border-radius: 6px;
                                                background: back_err_btn.pressed ? #33333d : (back_err_btn.has-hover ? #25252c : #18181f);
                                                border-width: 1px;
                                                border-color: #3b3b47;
                                                back_err_btn := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.player_back(); }
                                                }
                                                Text {
                                                    text: "← Back";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Informative loading status line
                            if !root.player_has_error : HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: root.player_status_msg != "" ? root.player_status_msg : "Connecting to BitTorrent swarm & probing video container...";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                }
                            }

                            // Collapsible Details Toggle
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 100px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: det_touch.has-hover ? #25262c : #181920;
                                    border-width: 1px;
                                    border-color: #2e3038;
                                    det_touch := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.player_toggle_details(); }
                                    }
                                    Text {
                                        text: root.player_show_details ? "Hide Details ▲" : "Show Details ▼";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Collapsible Details Log Drawer
                            if root.player_show_details : HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 440px;
                                    height: 96px;
                                    background: #0d0e12;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #24252e;
                                    clip: true;
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 2px;
                                            for ev in root.player_loading_events : Text {
                                                text: "› " + ev;
                                                font-size: 10px;
                                                color: Theme.text-muted;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // VIEW 3: DEDICATED SEARCH VIEW
                if root.current_view == 3 : SearchView {
                    search_text <=> root.search_text;
                    active_filter <=> root.active_filter;
                    active_genre <=> root.search_genre;
                    active_sort <=> root.search_sort;
                    sort_asc <=> root.search_sort_asc;
                    movie_results: root.search_movie_results;
                    series_results: root.search_series_results;
                    home_row1: root.home_row1;
                    home_row2: root.home_row2;
                    home_row3: root.home_row3;
                    home_row4: root.home_row4;
                    home_row1_indicator: root.home_row1_indicator;
                    home_row2_indicator: root.home_row2_indicator;
                    home_row3_indicator: root.home_row3_indicator;
                    home_row4_indicator: root.home_row4_indicator;
                    is_searching: root.is_searching;
                    card_size: root.settings_card_size;

                    search_submitted(q) => { root.search_submitted(q); }
                    filter_clicked(f) => {
                        root.active_filter = f;
                        root.filter_clicked(f);
                    }
                    genre_clicked(g) => {
                        root.search_genre = g;
                        root.search_genre_clicked(g);
                    }
                    sort_clicked(s) => {
                        root.search_sort = s;
                        root.search_sort_clicked(s);
                    }
                    sort_order_toggled(asc) => {
                        root.search_sort_asc = asc;
                        root.search_sort_order_toggled(asc);
                    }
                    card_selected(id, type) => { root.card_selected(id, type); }
                    request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                    prev_page(row) => { root.home_row_prev_page(row); }
                    next_page(row) => { root.home_row_next_page(row); }
                }

                // VIEW 4: LIBRARY & WATCH HISTORY VIEW
                if root.current_view == 4 : LibraryView {
                    library_items: root.library_items;
                    card_size: root.settings_card_size;
                    card_selected(id, type) => { root.card_selected(id, type); }
                    clear_history_clicked => { root.clear_watch_history(); }
                    explore_clicked => {
                        root.current_view = 0;
                    }
                    request_lazy_range(row, start, end) => { root.request_lazy_range(row, start, end); }
                }

                // VIEW 5: SETTINGS & ADD-ONS MANAGER VIEW
                if root.current_view == 5 : SettingsView {
                    active_tab <=> root.settings_active_tab;
                    addon_items: root.settings_addon_items;
                    max_resolution: root.settings_max_res;
                    prefer_mp4: root.settings_prefer_mp4;
                    sub_lang: root.settings_sub_lang;
                    audio_lang: root.settings_audio_lang;
                    autoplay_next: root.settings_autoplay_next;
                    seek_step: root.settings_seek_step;
                    torrent_cache_str: root.settings_torrent_cache_str;
                    image_cache_str: root.settings_image_cache_str;
                    max_cache_gb: root.settings_max_cache_gb;
                    keep_after_playback: root.settings_keep_playback;
                    reduce_animations: root.settings_reduce_anim;
                    hero_autorotate: root.settings_hero_rotate;
                    card_size: root.settings_card_size;
                    storage_path_str: root.settings_storage_path;
                    log_lines: root.log_lines;

                    has_crash_report: root.has_crash_report;

                    tab_changed(t) => { root.settings_tab_changed(t); }
                    install_addon_clicked(u) => { root.settings_install_addon(u); }
                    open_logs_clicked => { root.open_logs_folder(); }
                    copy_diagnostics_clicked => { root.copy_diagnostics(); }
                    dismiss_crash_clicked => { root.dismiss_crash_report(); }
                    toggle_addon_clicked(id) => { root.settings_toggle_addon(id); }
                    remove_addon_clicked(id) => { root.settings_remove_addon(id); }
                    priority_addon_clicked(id, up) => { root.settings_priority_addon(id, up); }
                    max_res_changed(r) => { root.settings_change_max_res(r); }
                    prefer_mp4_toggled(p) => { root.settings_change_prefer_mp4(p); }
                    sub_lang_changed(l) => { root.settings_change_sub_lang(l); }
                    audio_lang_changed(l) => { root.settings_change_audio_lang(l); }
                    autoplay_next_toggled(a) => { root.settings_change_autoplay_next(a); }
                    seek_step_changed(s) => { root.settings_change_seek_step(s); }
                    max_cache_changed(c) => { root.settings_change_max_cache(c); }
                    keep_playback_toggled(k) => { root.settings_change_keep_playback(k); }
                    clear_torrent_cache_clicked => { root.settings_clear_torrent_cache(); }
                    clear_image_cache_clicked => { root.settings_clear_image_cache(); }
                    reduce_anim_toggled(r) => { root.settings_change_reduce_anim(r); }
                    hero_rotate_toggled(h) => { root.settings_change_hero_rotate(h); }
                    card_size_changed(s) => { root.settings_change_card_size(s); }
                    clear_logs_clicked => { root.clear_logs(); }
                }
            }

            // COLLAPSIBLE SIDEBAR (Overlaid over content on the left)
            if root.current_view != 2 : sidebar := Sidebar {
                x: 0px;
                y: 0px;
                height: 100%;
                active_index: root.current_view == 0 ? 0 : (root.current_view == 3 ? 1 : (root.current_view == 4 ? 2 : (root.current_view == 5 ? 3 : 0)));

                nav_selected(idx) => {
                    if (idx == 0) { root.current_view = 0; }
                    else if (idx == 1) { root.current_view = 3; }
                    else if (idx == 2) { root.current_view = 4; }
                    else if (idx == 3) { root.current_view = 5; }
                }
                toggle_fullscreen => {
                    root.player_toggle_fullscreen();
                }
            }
        }

        // STARTUP SPLASH SCREEN OVERLAY
        if root.is_app_initializing : Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: #0b0b0e;

            VerticalLayout {
                alignment: center;
                spacing: 14px;

                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("icons/brand/strawberry32-color.svg");
                        width: 110px;
                        height: 110px;
                        image-fit: contain;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Strawberry32";
                        font-size: 34px;
                        font-weight: 800;
                        color: #ffffff;
                        horizontal-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Fast native streaming for Surface RT & ARM32";
                        font-size: 14px;
                        font-weight: 500;
                        color: #8e8e9a;
                        horizontal-alignment: center;
                    }
                }

                Rectangle { height: 16px; }

                // Slim 240x4px loading bar (Centered)
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 240px;
                        height: 4px;
                        background: #1c1c24;
                        border-radius: 2px;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 120px;
                            height: 100%;
                            background: Theme.accent;
                            border-radius: 2px;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Loading catalog & add-ons...";
                        font-size: 12px;
                        color: #70707c;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
