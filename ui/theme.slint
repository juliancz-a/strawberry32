export global Theme {
    // Color tokens
    in property <color> bg: #151617;
    in property <color> surface: #252627;
    in property <color> surface-hover: #303133;
    in property <color> surface-raised: #3A3B3E;
    in property <color> accent: #FC5A8D;
    in property <color> accent-pressed: #D94A77;
    in property <color> on-accent: #252627;
    in property <color> violet: #420039;
    in property <color> violet-soft: #6A2A5F;
    in property <color> text: #EDE6F2;
    in property <color> text-muted: #A7A3AB;
    in property <color> text-faint: #6E6B73;
    in property <color> danger: #9A1900;
    in property <color> danger-text: #FF8A6B;
    in property <color> ok: #7BD88F;
    in property <color> scrim: #000000;

    // Overlay color-key for hardware video transparency
    in property <color> overlay-color-key: #010002;

    // Setting: animations enabled (toggled via interface settings)
    in-out property <bool> animations-enabled: true;
}

